# Copy to .env. Only the key for the --api you run is needed.

# Required for --api openrouter (used for the Llama results)
OPENROUTER_API_KEY=

# Required for --api vllm (Mistral and Qwen runs; the Kaggle notebook sets it itself)
# VLLM_BASE_URL=http://localhost:8000/v1
# Optional, default EMPTY
# VLLM_API_KEY=EMPTY

# Optional, only for the other backends (not used for any reported result)
# GROQ_API_KEY=
# NVIDIA_API_KEY=
# HF_TOKEN=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional, --api openrouter only, for reasoning models: low / medium / high, or off
# LLM_REASONING_EFFORT=
