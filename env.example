# Copy to .env. Reproducing the tables from the saved runs needs no key.

# Main: --api openrouter (used for the Llama results)
OPENROUTER_API_KEY=

# Optional: --api vllm (Mistral and Qwen runs; the Kaggle notebook sets it itself)
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_API_KEY=EMPTY

# Optional: other backends (not used for any reported result)
# GROQ_API_KEY=
# NVIDIA_API_KEY=
# HF_TOKEN=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional: --api openrouter only, for reasoning models: low / medium / high, or off
# LLM_REASONING_EFFORT=
