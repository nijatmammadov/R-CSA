# Copy to .env. Every key is optional: set only the one for the --api you run.
# Reproducing the tables from the saved runs needs no key.

# --api openrouter (used for the Llama results)
# OPENROUTER_API_KEY=

# --api vllm (Mistral and Qwen runs; the Kaggle notebook sets it itself)
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_API_KEY=EMPTY

# other backends (not used for any reported result)
# GROQ_API_KEY=
# NVIDIA_API_KEY=
# HF_TOKEN=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --api openrouter only, for reasoning models: low / medium / high, or off
# LLM_REASONING_EFFORT=
